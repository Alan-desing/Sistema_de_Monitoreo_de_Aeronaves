# Copiar este archivo a .env y completar los valores.
# docker-compose.yml lo pasa al servicio backend; nunca se copia en la imagen.

# --- Django ---
# Generar una clave larga y aleatoria, por ejemplo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TZ=America/Argentina/Buenos_Aires
LOG_LEVEL=INFO

# --- Valores iniciales de la configuración ---
# Se usan SOLO la primera vez que arranca el sistema con la base vacía.
# Después se editan desde la pantalla de Configuración de la web.

# Zona de alerta: 35°06'43" S, 58°43'34" W
ZONE_NAME=ALERTA CNA 10KM
ZONE_LAT=-35.111944
ZONE_LON=-58.726111
ZONE_RADIUS_NM=5.4
# Altura inferior en metros; 0 = superficie (sin límite inferior)
ZONE_FLOOR_M=0
ZONE_CEILING_M=4400

# Frecuencia de consulta a adsb.fi en segundos (mínimo 2)
POLL_INTERVAL_S=5
# Radio de la consulta y del mapa en NM (máximo 250, no menor que el de la zona)
QUERY_RADIUS_NM=50

# --- adsb.fi ---
# false = levantar la web sin consultar adsb.fi (solo para depurar)
MONITOR_ENABLED=true
# User-Agent identificable que se envía en cada consulta
ADSBFI_USER_AGENT=avion-monitor/0.1 (monitor privado de aeronaves)

# --- Telegram ---
# Token del bot (de @BotFather) y chat id del grupo (número negativo).
# Dejar ambos vacíos para no enviar alertas por Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
